# 本地示例配置：所有地址仅指向 localhost，不含真实凭据
APP_ENV=prod
VISUALIZATION_ONLY=true

# 平台鉴权（Phase 1）：pepper 用于 API Key 摘要的 HMAC 签名，本地随机生成即可
API_KEY_PEPPER=replace-with-a-random-secret
LEGACY_API_ENABLED=false

CHAT_MODEL_URL=http://localhost:8000/v1
CHAT_MODEL_NAME=Qwen3-Omni-30B-A3B-Instruct
CHAT_MODEL_KEY=
CHAT_MODEL_TIMEOUT=120
CHAT_MODEL_REQUEST_RETRIES=2
CHAT_MODEL_CURL_FALLBACK=true
CHAT_MODEL_CURL_PATH=curl

EMBEDDING_SERVER=http://localhost:8090/v1
EMBEDDING_KEY=
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=embedding_db

WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=bocha_internal
WEB_SEARCH_URL=http://localhost:31887/web_search
WEB_SEARCH_DEFAULT_COUNT=3
WEB_SEARCH_MAX_COUNT=10
WEB_SEARCH_DEFAULT_ANSWER=false
WEB_SEARCH_TIMEOUT=15
